# Usuario u organización de Docker Hub donde se publica parental.
DOCKERHUB_USERNAME=
IMAGE_TAG=latest
APP_TOKEN=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres
BIND_ADDRESS=127.0.0.1
# Puerto publicado en el host; la app y su healthcheck siguen usando 8080 interno.
APP_PORT=8080
# También puedes configurar la conexión en la pantalla Servidor.
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASSWORD=
# Contacto VAPID para Web Push: mailto:correo@dominio-real o https://dominio-real (sin ruta).
# Apple rechaza dominios locales (localhost, .local, .lan). Vacío usa https://github.com.
WEB_PUSH_CONTACT=
DEMO=false
